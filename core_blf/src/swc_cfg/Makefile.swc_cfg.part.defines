###############################################################################
# Makefile.swc_cfg.part.defines
###############################################################################

ifeq ($(SRC_INCLUDE_SWC_CFG),1)

# Source - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -#
SRC_DIR += $(SWCCFG_DIR)/sources


# Header - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -#
INCLUDES += $(addprefix -I, $(SWCCFG_DIR)/include)

endif
