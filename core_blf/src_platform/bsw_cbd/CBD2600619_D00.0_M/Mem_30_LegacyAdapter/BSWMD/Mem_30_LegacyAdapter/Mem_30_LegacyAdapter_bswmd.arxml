				<AR-PACKAGE UUID="42655098-2d9d-425f-8fea-9c09a27c0acc">
					<SHORT-NAME>Mem_30_LegacyAdapter</SHORT-NAME>
					<ELEMENTS>
						<ECUC-MODULE-DEF UUID="cef2af21-008e-442a-904b-9746e4153551">
							<SHORT-NAME>Mem</SHORT-NAME>
							<DESC>
								<L-2 L="EN">Vector Mem-to-vMem adapter. Provides services to access and operate non-volatile memory of vMem/fls/eep drivers.

#NVRAM #NVMemory #Memory #DataStorage #AUTOSAR #FBL #Vector</L-2>
							</DESC>
							<CATEGORY>VENDOR_SPECIFIC_MODULE_DEFINITION</CATEGORY>
							<ADMIN-DATA>
								<DOC-REVISIONS>
									<DOC-REVISION>
										<REVISION-LABEL>4.9.0</REVISION-LABEL>
										<ISSUED-BY>AUTOSAR</ISSUED-BY>
									</DOC-REVISION>
								</DOC-REVISIONS>
							</ADMIN-DATA>
							<INTRODUCTION>
								<P>
									<L-1 L="EN">Its multiplicity describes the actual number of Mem drivers. There will be one container for each Mem driver.</L-1>
								</P>
							</INTRODUCTION>
							<RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Mem_00001</RELATED-TRACE-ITEM-REF>
							<LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
							<UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
