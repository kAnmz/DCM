										</CHANGE>
										<REASON>
											<L-2 L="EN">MWDG-8118</L-2>
										</REASON>
									</MODIFICATION>
								</MODIFICATIONS>
							</DOC-REVISION>
							<DOC-REVISION>
								<REVISION-LABEL>6.05.00</REVISION-LABEL>
								<STATE>released</STATE>
								<ISSUED-BY>virbmz</ISSUED-BY>
								<DATE>2023-10-24T10:27:21+02:00</DATE>
								<MODIFICATIONS>
									<MODIFICATION>
										<CHANGE>
											<L-2 L="EN">vMemAccM shall support downloadable external vMem drivers</L-2>
										</CHANGE>
										<REASON>
											<L-2 L="EN">MEMSLP-8368</L-2>
										</REASON>
									</MODIFICATION>
								</MODIFICATIONS>
							</DOC-REVISION>
							<DOC-REVISION>
								<REVISION-LABEL>6.06.00</REVISION-LABEL>
