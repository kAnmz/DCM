							<DOC-REVISION>
								<REVISION-LABEL>6.06.01</REVISION-LABEL>
								<STATE>released</STATE>
								<ISSUED-BY>virbka</ISSUED-BY>
								<DATE>2025-04-15T12:49:56+02:00</DATE>
								<MODIFICATIONS>
									<MODIFICATION>
										<CHANGE>
											<L-2 L="EN">SW version number update</L-2>
										</CHANGE>
										<REASON>
											<L-2 L="EN">ESCAN00119901</L-2>
										</REASON>
									</MODIFICATION>
