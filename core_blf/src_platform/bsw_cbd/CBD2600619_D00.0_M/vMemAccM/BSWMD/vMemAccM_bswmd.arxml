				<ECUC-MODULE-DEF UUID="8450a790-7469-4c0f-8e01-cb073c5023bf">
					<SHORT-NAME>vMemAccM</SHORT-NAME>
					<LONG-NAME>
						<L-4 L="EN">Memory Access Manager</L-4>
					</LONG-NAME>
					<DESC>
						<L-2 L="EN">The vMemAccM (Memory Access Manager) coordinates the NV (non volatile) memory access by multiple users in order to avoid conflicts with this shared resource.
The module abstracts from the NV RAM device specific addressing scheme and provides the upper layers with a virtual addressing scheme.

#NVRAM #NVMemory #Memory #DataStorage
#MICROSAR</L-2>
					</DESC>
					<CATEGORY>VENDOR_SPECIFIC_MODULE_DEFINITION</CATEGORY>
