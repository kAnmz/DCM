			<ELEMENTS>
				<ECUC-MODULE-DEF UUID="e10683c9-323e-42e5-b8f2-1b907e2fe89a">
					<SHORT-NAME>MemAcc</SHORT-NAME>
					<DESC>
						<L-2 L="EN">The MemAcc (Memory Access module) coordinates the memory access by multiple users in order to avoid conflicts with this shared memory resource.

#NVRAM #NVMemory #Memory #DataStorage 
#AUTOSAR</L-2>
					</DESC>
					<CATEGORY>VENDOR_SPECIFIC_MODULE_DEFINITION</CATEGORY>
