										<!-- PARAMETER DEFINITION: MemAccMemInvocation -->
										<ECUC-ENUMERATION-PARAM-DEF UUID="f1ba99e8-5f6c-4602-8e30-5b59bb85bfd3">
											<SHORT-NAME>MemAccMemInvocation</SHORT-NAME>
											<DESC>
												<L-2 L="EN">Defines how the Mem driver services are accessed and how the Mem driver is scheduled and activated/initialized.

DIRECT_STATIC: Mem driver will be accessed directly. Mem will not be initialized and triggered by MemAcc.
INDIRECT_STATIC: Mem driver will be accessed indirectly via a function pointer table. Mem will be initialized and triggered by MemAcc.
INDIRECT_DYNAMIC: Mem can only be accessed after explicit activation. Mem will be initialized and triggered by MemAcc.

See technical reference for more details.</L-2>
											</DESC>
											<RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_MemAcc_00026</RELATED-TRACE-ITEM-REF>
