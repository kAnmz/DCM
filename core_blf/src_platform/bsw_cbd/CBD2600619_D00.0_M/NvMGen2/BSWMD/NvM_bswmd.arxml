						<ECUC-MODULE-DEF UUID="cf46d5c3-3db3-4238-8e22-81cd5cd9e2a9">
							<SHORT-NAME>NvM</SHORT-NAME>
							<DESC>
								<L-2 L="EN">NV RAM Manager. Provides services to ensure the data storage and maintenance of NV data according to their individual requirements in an automotive environment. The NvM administrates the NV data of an EEPROM and/or a FLASH EEPROM emulation device.


#NVRAM #NVMemory #DataStorage

#AUTOSAR #ServiceComponent</L-2>
							</DESC>
							<CATEGORY>VENDOR_SPECIFIC_MODULE_DEFINITION</CATEGORY>
