								<ECUC-PARAM-CONF-CONTAINER-DEF UUID="8cdd22cb-bc78-4c48-aa54-21c02a05f85f">
									<SHORT-NAME>NvMCommonVendorParams</SHORT-NAME>
									<LONG-NAME>
										<L-4 L="EN">Common Vendor Parameter</L-4>
									</LONG-NAME>
									<DESC>
										<L-2 L="EN">This container includes Vector specific Module Configuration Parameters.</L-2>
									</DESC>
									<ADMIN-DATA>
										<SDGS>
											<SDG GID="DV:CfgPostBuild">
												<SD GID="DV:postBuildSelectableChangeable">false</SD>
												<SD GID="DV:postBuildNotDeletable">false</SD>
											</SDG>
										</SDGS>
									</ADMIN-DATA>
									<LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
									<UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
									<POST-BUILD-CHANGEABLE>false</POST-BUILD-CHANGEABLE>
									<PARAMETERS>
										<ECUC-STRING-PARAM-DEF UUID="f12186a6-dd66-4b1b-8c43-45dc8aa14424">
											<SHORT-NAME>NvMCfgCbkIncludeList</SHORT-NAME>
											<LONG-NAME>
												<L-4 L="EN">Callback Include File List</L-4>
											</LONG-NAME>
											<DESC>
												<L-2 L="EN">This parameter contains the header file(s) declaring the call back functions, and the blocks' symbol declarations, i.e. the multi block callback the single block call backs, the block init callbacks, the ram block symbols as well as the rom block symbols.</L-2>
											</DESC>
											<LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
											<UPPER-MULTIPLICITY-INFINITE>true</UPPER-MULTIPLICITY-INFINITE>
											<IMPLEMENTATION-CONFIG-CLASSES>
												<ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
													<CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
													<CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
												</ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
											</IMPLEMENTATION-CONFIG-CLASSES>
											<ORIGIN>Vector Informatik</ORIGIN>
											<REQUIRES-INDEX>false</REQUIRES-INDEX>
											<SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
											<ECUC-STRING-PARAM-DEF-VARIANTS>
												<ECUC-STRING-PARAM-DEF-CONDITIONAL>
													<DEFAULT-VALUE>Application.h</DEFAULT-VALUE>
												</ECUC-STRING-PARAM-DEF-CONDITIONAL>
											</ECUC-STRING-PARAM-DEF-VARIANTS>
										</ECUC-STRING-PARAM-DEF>
										<ECUC-BOOLEAN-PARAM-DEF UUID="9c97fd20-cf4f-4485-a4d9-2b2ccc41fb86">
											<SHORT-NAME>NvMDataIntegrityIntBuffer</SHORT-NAME>
											<LONG-NAME>
												<L-4 L="EN">Data Integrity Buffer</L-4>
											</LONG-NAME>
											<DESC>
												<L-2 L="EN">This parameter defines whether the data integrity buffer is provided internally.

true: The NVM provides the buffer for the data integrity value internally. Memory for data integrity must not be allocated at the end of Ram Block variable.

false: The NVM does not provide the buffer for the data integrity value. Memory for data integrity value at the end of Ram Block variable is necessary!
</L-2>
											</DESC>
											<ADMIN-DATA>
												<SDGS>
													<SDG GID="DV:CfgPostBuild">
														<SD GID="DV:variantMultiplicityPBL">false</SD>
													</SDG>
												</SDGS>
											</ADMIN-DATA>
											<LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
											<UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
											<IMPLEMENTATION-CONFIG-CLASSES>
												<ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
													<CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
													<CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
												</ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
											</IMPLEMENTATION-CONFIG-CLASSES>
											<ORIGIN>Vector Informatik</ORIGIN>
											<REQUIRES-INDEX>false</REQUIRES-INDEX>
											<SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
											<DEFAULT-VALUE>true</DEFAULT-VALUE>
										</ECUC-BOOLEAN-PARAM-DEF>
										<ECUC-BOOLEAN-PARAM-DEF UUID="35d52f29-e408-4f75-adfa-e0489bbd198f">
											<SHORT-NAME>NvMKillWriteAllApi</SHORT-NAME>
											<LONG-NAME>
												<L-4 L="EN">Kill WriteAll API</L-4>
											</LONG-NAME>
											<DESC>
												<L-2 L="EN">[Not supported]

This parameter defines if the API NvM_KillWriteAll  is available. The API gives users (i.e. EcuM) the possibility to time-out WriteAll cancellation (NvM_CancelWriteAll).</L-2>
											</DESC>
											<ADMIN-DATA>
												<SDGS>
													<SDG GID="DV:CfgPostBuild">
														<SD GID="DV:variantMultiplicityPBL">false</SD>
													</SDG>
												</SDGS>
											</ADMIN-DATA>
											<LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
											<UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
											<IMPLEMENTATION-CONFIG-CLASSES>
												<ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
													<CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
													<CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
												</ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
											</IMPLEMENTATION-CONFIG-CLASSES>
											<ORIGIN>Vector Informatik</ORIGIN>
											<REQUIRES-INDEX>false</REQUIRES-INDEX>
											<SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
											<DEFAULT-VALUE>true</DEFAULT-VALUE>
										</ECUC-BOOLEAN-PARAM-DEF>
										<ECUC-BOOLEAN-PARAM-DEF UUID="d5c4633f-6275-40ad-a23c-7783d784c732">
											<SHORT-NAME>NvMDataSyncParameterCombination</SHORT-NAME>
											<LONG-NAME>
												<L-4 L="EN">Data Synchronization Parameter Combination</L-4>
											</LONG-NAME>
											<DESC>
												<L-2 L="EN">If enabled, the combination of the parameters NvM/NvMBlockDescriptor/NvMRamBlockDataAddress and NvM/NvMBlockDescriptor/NvMBlockUseSyncMechanism is allowed.
If disabled, the combination is not allowed.

This feature is there to cover the special case, that block length check and automatic block length features can also be used for blocks with explicit sync mechanism enabled.
</L-2>
											</DESC>
											<ADMIN-DATA>
												<SDGS>
													<SDG GID="DV:CfgPostBuild">
														<SD GID="DV:variantMultiplicityPBL">false</SD>
													</SDG>
												</SDGS>
											</ADMIN-DATA>
											<LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
											<UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
											<IMPLEMENTATION-CONFIG-CLASSES>
												<ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
													<CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
													<CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
												</ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
											</IMPLEMENTATION-CONFIG-CLASSES>
											<ORIGIN>Vector Informatik</ORIGIN>
											<REQUIRES-INDEX>false</REQUIRES-INDEX>
											<SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
											<DEFAULT-VALUE>false</DEFAULT-VALUE>
										</ECUC-BOOLEAN-PARAM-DEF>
										<ECUC-FUNCTION-NAME-DEF UUID="78caba2e-8d26-4e07-82fa-1f382461834a">
											<SHORT-NAME>NvMProvideDynamicConfigIdCallback</SHORT-NAME>
											<LONG-NAME>
												<L-4 L="EN">Provide Dynamic Config ID Callback</L-4>
											</LONG-NAME>
											<DESC>
												<L-2 L="EN">This parameter defines a callback which can provide the Config ID. This ID is then compared to the Config ID which is stored within the Config Block.
This mechanism can be used instead of using the compiled Config ID.
Additional Information: When using the callback, the Config ID length can be any uint16 value.</L-2>
											</DESC>
											<LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
											<UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
											<IMPLEMENTATION-CONFIG-CLASSES>
												<ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
													<CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
													<CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
												</ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
											</IMPLEMENTATION-CONFIG-CLASSES>
											<ORIGIN>Vector Informatik</ORIGIN>
											<REQUIRES-INDEX>false</REQUIRES-INDEX>
											<SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
											<ECUC-FUNCTION-NAME-DEF-VARIANTS>
												<ECUC-FUNCTION-NAME-DEF-CONDITIONAL>
													<DEFAULT-VALUE>NULL_PTR</DEFAULT-VALUE>
												</ECUC-FUNCTION-NAME-DEF-CONDITIONAL>
											</ECUC-FUNCTION-NAME-DEF-VARIANTS>
										</ECUC-FUNCTION-NAME-DEF>
									</PARAMETERS>
								</ECUC-PARAM-CONF-CONTAINER-DEF>
							</CONTAINERS>
						</ECUC-MODULE-DEF>
						<ECUC-MODULE-CONFIGURATION-VALUES UUID="f6a7c7a2-eba8-479c-b1a5-065d0f8a10d9">
							<SHORT-NAME>NvM_Pre</SHORT-NAME>
							<DEFINITION-REF DEST="ECUC-MODULE-DEF">/MICROSAR/NvMGen2/NvM</DEFINITION-REF>
							<CONTAINERS>
