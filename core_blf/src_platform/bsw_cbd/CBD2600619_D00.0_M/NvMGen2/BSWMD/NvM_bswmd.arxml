								<!-- Container Definition: NvMCommon -->
								<ECUC-PARAM-CONF-CONTAINER-DEF UUID="0ed1c73c-cb7e-46ee-bf57-58f35e886a41">
									<SHORT-NAME>NvMCommon</SHORT-NAME>
									<DESC>
										<L-2 L="EN">This container includes the common configuration options.</L-2>
									</DESC>
									<ADMIN-DATA>
										<SDGS>
											<SDG GID="DV:CfgPostBuild">
												<SD GID="DV:postBuildSelectableChangeable">false</SD>
												<SD GID="DV:postBuildNotDeletable">false</SD>
											</SDG>
										</SDGS>
									</ADMIN-DATA>
									<LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
									<UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
									<POST-BUILD-CHANGEABLE>false</POST-BUILD-CHANGEABLE>
									<MULTIPLE-CONFIGURATION-CONTAINER>false</MULTIPLE-CONFIGURATION-CONTAINER>
									<PARAMETERS>
										<!-- PARAMETER DEFINITION: NvMApiConfigClass -->
										<ECUC-ENUMERATION-PARAM-DEF UUID="b3d40dc3-c8e2-4dd2-9971-98d9d561c0b1">
											<SHORT-NAME>NvMApiConfigClass</SHORT-NAME>
											<LONG-NAME>
												<L-4 L="EN">API Configuration Class</L-4>
											</LONG-NAME>
											<DESC>
												<L-2 L="EN">This parameter specifies the available set of NvM services. 
For each configuration class the available services are listed below.

The following services are available in all configuration classes:
- NvM_Init
- NvM_SetDataIndex
- NvM_GetDataIndex
- NvM_GetErrorStatus
- NvM_GetVersionInfo
- NvM_SetRamBlockStatus
- NvM_ReadAll
- NvM_KillReadAll
- NvM_WriteAll
- NvM_CancelWriteAll
- NvM_KillWriteAll
- NvM_MainFunction

The following services are available in NVM_API_CONFIG_CLASS_2 and NVM_API_CONFIG_CLASS_3:
- NvM_ReadBlock
- NvM_WriteBlock
- NvM_RestoreBlockDefaults
- NvM_CancelJobs

The following services are available in NVM_API_CONFIG_CLASS_3:
- NvM_SetBlockProtection
- NvM_EraseNvBlock
- NvM_InvalidateNvBlock</L-2>
											</DESC>
