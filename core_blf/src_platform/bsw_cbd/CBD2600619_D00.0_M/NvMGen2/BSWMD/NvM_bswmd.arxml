											<MIN>1</MIN>
										</ECUC-INTEGER-PARAM-DEF>
										<!-- PARAMETER DEFINITION: NvMVersionInfoApi -->
										<ECUC-BOOLEAN-PARAM-DEF UUID="957943b7-6da8-4eb7-aa54-3b6ede2b8893">
											<SHORT-NAME>NvMVersionInfoApi</SHORT-NAME>
											<LONG-NAME>
												<L-4 L="EN">Version Information API</L-4>
											</LONG-NAME>
											<DESC>
												<L-2 L="EN">[Not supported]

This parameter enables/disables the function NvM_GetVersionInfo() to get major, minor and patch version information.</L-2>
											</DESC>
											<ADMIN-DATA>
												<SDGS>
													<SDG GID="DV:CfgPostBuild">
														<SD GID="DV:variantMultiplicityPBL">false</SD>
													</SDG>
												</SDGS>
											</ADMIN-DATA>
											<INTRODUCTION>
												<P>
													<L-1 L="EN">true:	Version info API enabled.
                                        false:	Version info API disabled.</L-1>
												</P>
											</INTRODUCTION>
											<LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
											<UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
											<IMPLEMENTATION-CONFIG-CLASSES>
												<ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
													<CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
													<CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
												</ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
											</IMPLEMENTATION-CONFIG-CLASSES>
											<ORIGIN>AUTOSAR_ECUC</ORIGIN>
											<REQUIRES-INDEX>false</REQUIRES-INDEX>
											<SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
											<DEFAULT-VALUE>false</DEFAULT-VALUE>
										</ECUC-BOOLEAN-PARAM-DEF>
										<ECUC-INTEGER-PARAM-DEF UUID="1763725c-4160-4d36-9155-c9fcfcf507fd">
											<SHORT-NAME>NvMMaxNoOfWriteRetries</SHORT-NAME>
											<LONG-NAME>
												<L-4 L="EN">Maximum Number of Write Retries</L-4>
											</LONG-NAME>
											<DESC>
												<L-2 L="EN">This value specifies the maximum number of write retries for a NVRAM block. Regardless of configuration a consistency check and write retries are always forced for each block which is processed by the request NvM_WriteAll and NvM_WriteBlock.
Enabling this MICROSAR parameter applies retries globally to every block, which diverges from AUTOSAR’s per-block MaxNoOfWriteRetries behavior. Setting the parameter to 0 disables retries.</L-2>
											</DESC>
											<ADMIN-DATA>
												<SDGS>
													<SDG GID="DV:CfgPostBuild">
														<SD GID="DV:variantMultiplicityPBL">false</SD>
													</SDG>
												</SDGS>
											</ADMIN-DATA>
											<LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
											<UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
											<IMPLEMENTATION-CONFIG-CLASSES>
												<ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
													<CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
													<CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
												</ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
											</IMPLEMENTATION-CONFIG-CLASSES>
											<ORIGIN>Vector Informatik</ORIGIN>
											<REQUIRES-INDEX>false</REQUIRES-INDEX>
											<SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
											<DEFAULT-VALUE>1</DEFAULT-VALUE>
											<MAX>7</MAX>
											<MIN>0</MIN>
										</ECUC-INTEGER-PARAM-DEF>
										<ECUC-FLOAT-PARAM-DEF UUID="c33584da-5b5f-4031-9096-c99c61a6a7ba">
											<SHORT-NAME>NvMMainFunctionPeriod</SHORT-NAME>
											<LONG-NAME>
												<L-4 L="EN">Call Cycle of NvM_MainFunction</L-4>
											</LONG-NAME>
											<DESC>
												<L-2 L="EN">Specify fixed call cycle for NvM_MainFunction.
This information affects RTE's (SchM's) settings.

NVM itself does not depend on a fixed cycle time; in can be triggered at arbitrary rates.

It is not necessary to rigger NVM faster than its lower layers (FEE/EA and FLS/EEP).
Also consider NvMCrcNumOf Bytes, which limits the maximim MainFunction processing times during CRC Calculation as well as internal copie operations.
The faster you want NvM_MainFunction being triggered, the smaller this value should be and vice versa.

Note, that notifcation functions may arbitrarily extend NvM_MainFunction's maximum duration. This is an issue especially for init callbacks as well as for explicit synchronization callbacks, as they would have to process a block at once.</L-2>
											</DESC>
											<ADMIN-DATA>
												<SDGS>
													<SDG GID="DV:Display">
														<SD GID="DV:BaseUnit">SEC</SD>
														<SD GID="DV:Unit">MSEC</SD>
													</SDG>
													<SDG GID="DV:CfgPostBuild">
														<SD GID="DV:variantMultiplicityPBL">false</SD>
													</SDG>
												</SDGS>
											</ADMIN-DATA>
											<LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
											<UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
											<IMPLEMENTATION-CONFIG-CLASSES>
												<ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
													<CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
													<CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
												</ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
											</IMPLEMENTATION-CONFIG-CLASSES>
											<ORIGIN>Vector Informatik</ORIGIN>
											<REQUIRES-INDEX>false</REQUIRES-INDEX>
											<SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
											<DEFAULT-VALUE>0.01</DEFAULT-VALUE>
											<MAX>1</MAX>
											<MIN>0.001</MIN>
										</ECUC-FLOAT-PARAM-DEF>
										<ECUC-BOOLEAN-PARAM-DEF UUID="c8ffee4b-24b9-44b7-83ee-935f6aa6e788">
											<SHORT-NAME>NvMUseBlockIdCheck</SHORT-NAME>
											<LONG-NAME>
												<L-4 L="EN">Use Block Id Check for Blocks with Crc</L-4>
											</LONG-NAME>
											<DESC>
												<L-2 L="EN">If enabled, the NvM checks whether the data provided by the underlying modules belongs to the requested NvM block. 
This only works for blocks configured with Crc, as the NvM uses Crc for this functionality!
This function remains unused if there is no block with Crc.</L-2>
											</DESC>
											<ADMIN-DATA>
												<SDGS>
													<SDG GID="DV:CfgPostBuild">
														<SD GID="DV:variantMultiplicityPBL">false</SD>
													</SDG>
												</SDGS>
											</ADMIN-DATA>
											<LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
											<UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
											<IMPLEMENTATION-CONFIG-CLASSES>
												<ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
													<CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
													<CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
												</ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
											</IMPLEMENTATION-CONFIG-CLASSES>
											<ORIGIN>Vector Informatik</ORIGIN>
											<REQUIRES-INDEX>false</REQUIRES-INDEX>
											<SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
											<DEFAULT-VALUE>false</DEFAULT-VALUE>
										</ECUC-BOOLEAN-PARAM-DEF>
										<ECUC-BOOLEAN-PARAM-DEF UUID="f97b9cb8-6afb-4425-b3aa-eedd76e8680a">
											<SHORT-NAME>NvMRepairRedundantBlocksApi</SHORT-NAME>
											<LONG-NAME>
												<L-4 L="EN">Repair Redundant Blocks Api</L-4>
											</LONG-NAME>
											<DESC>
												<L-2 L="EN">[Not supported]

Enables the NvM background job "Repair Redundant Blocks", which iterates over all configured redundant blocks and checks their redundancy within the NV RAM. If the redundancy is lost, the job will try to repair it.</L-2>
											</DESC>
											<ADMIN-DATA>
												<SDGS>
													<SDG GID="DV:CfgPostBuild">
														<SD GID="DV:variantMultiplicityPBL">false</SD>
													</SDG>
												</SDGS>
											</ADMIN-DATA>
											<LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
											<UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
											<IMPLEMENTATION-CONFIG-CLASSES>
												<ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
													<CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
													<CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
												</ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
											</IMPLEMENTATION-CONFIG-CLASSES>
											<ORIGIN>Vector Informatik</ORIGIN>
											<REQUIRES-INDEX>false</REQUIRES-INDEX>
											<SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
											<DEFAULT-VALUE>false</DEFAULT-VALUE>
										</ECUC-BOOLEAN-PARAM-DEF>
										<ECUC-BOOLEAN-PARAM-DEF UUID="47bbb35a-7a3d-4fa0-9980-520880ef4aef">
											<SHORT-NAME>NvMSafeBswChecks</SHORT-NAME>
											<LONG-NAME>
												<L-4 L="EN">Safe BSW Checks</L-4>
											</LONG-NAME>
											<DESC>
												<L-2 L="EN">Selects if safety checks are used. These checks improve robustness as e.g. invalid parameters are checked before function is executed. This attribute has to be enabled for safety projects where this component is mapped to an ASIL partition.</L-2>
											</DESC>
											<ADMIN-DATA>
												<SDGS>
													<SDG GID="DV:CfgPostBuild">
														<SD GID="DV:variantMultiplicityPBL">false</SD>
													</SDG>
												</SDGS>
											</ADMIN-DATA>
											<LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
											<UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
											<IMPLEMENTATION-CONFIG-CLASSES>
												<ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
													<CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
													<CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
												</ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
											</IMPLEMENTATION-CONFIG-CLASSES>
											<ORIGIN>Vector Informatik</ORIGIN>
											<REQUIRES-INDEX>false</REQUIRES-INDEX>
											<SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
											<DEFAULT-VALUE>true</DEFAULT-VALUE>
										</ECUC-BOOLEAN-PARAM-DEF>
										<ECUC-INTEGER-PARAM-DEF UUID="7f7d4076-0cb6-4003-a3e2-1a6b1924f0b5">
											<SHORT-NAME>NvMCsmRetryCounter</SHORT-NAME>
											<DESC>
												<L-2 L="EN">This value specifies the number of CSM encryption/decryption job retry attempts. 

CSM jobs for block reading and writing may fail (e.g. module busy, queue full, ...). 
To not directly abort the read/write with an error status, the NvM will retry the CSM job for the configured NvMCsmRetryCounter times.

Configuring 0 means: no retry behavior; job will be aborted directly.</L-2>
											</DESC>
											<ADMIN-DATA>
												<SDGS>
													<SDG GID="DV:CfgPostBuild">
														<SD GID="DV:variantMultiplicityPBL">false</SD>
													</SDG>
												</SDGS>
											</ADMIN-DATA>
											<LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
											<UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
											<IMPLEMENTATION-CONFIG-CLASSES>
												<ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
													<CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
													<CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
												</ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
											</IMPLEMENTATION-CONFIG-CLASSES>
											<ORIGIN>Vector Informatik</ORIGIN>
											<REQUIRES-INDEX>false</REQUIRES-INDEX>
											<SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
											<DEFAULT-VALUE>0</DEFAULT-VALUE>
											<MAX>255</MAX>
											<MIN>0</MIN>
										</ECUC-INTEGER-PARAM-DEF>
										<ECUC-FUNCTION-NAME-DEF UUID="5a1f6189-c28b-4a6a-895e-23a8c55e3401">
											<SHORT-NAME>NvMDetectedLossOfRedundancyCallback</SHORT-NAME>
											<DESC>
												<L-2 L="EN">[Not supported]

This parameter defines the notification callback routine that will be called when a loss of redundancy was detected when reading a block. 

Note: Will only be invoked for blocks with enabled NvM/NvMBlockDescriptor/NvMCheckLossOfRedundancy.</L-2>
											</DESC>
											<LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
											<UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
											<IMPLEMENTATION-CONFIG-CLASSES>
												<ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
													<CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
													<CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
												</ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
											</IMPLEMENTATION-CONFIG-CLASSES>
											<ORIGIN>Vector Informatik</ORIGIN>
											<REQUIRES-INDEX>false</REQUIRES-INDEX>
											<SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
											<ECUC-FUNCTION-NAME-DEF-VARIANTS>
												<ECUC-FUNCTION-NAME-DEF-CONDITIONAL>
													<DEFAULT-VALUE>NULL_PTR</DEFAULT-VALUE>
												</ECUC-FUNCTION-NAME-DEF-CONDITIONAL>
											</ECUC-FUNCTION-NAME-DEF-VARIANTS>
										</ECUC-FUNCTION-NAME-DEF>
										<ECUC-BOOLEAN-PARAM-DEF UUID="b538a09c-3444-4b8f-b2ed-db20435fea1c">
											<SHORT-NAME>NvMUseAsr440CallbackInterface</SHORT-NAME>
											<DESC>
												<L-2 L="EN">If enabled, the signature of following parameters will be used as defined since AUTOSAR version 4.4.0: 

- NvM/NvMBlockDescriptor/NvMSingleBlockCallback
- NvM/NvMCommon/NvMMultiBlockCallback</L-2>
											</DESC>
											<LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
											<UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
											<IMPLEMENTATION-CONFIG-CLASSES>
												<ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
													<CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
													<CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
												</ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
											</IMPLEMENTATION-CONFIG-CLASSES>
											<ORIGIN>Vector Informatik</ORIGIN>
											<REQUIRES-INDEX>false</REQUIRES-INDEX>
											<SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
											<DEFAULT-VALUE>false</DEFAULT-VALUE>
										</ECUC-BOOLEAN-PARAM-DEF>
										<ECUC-ENUMERATION-PARAM-DEF UUID="6f120ff3-5699-42fb-b83a-e0f2f71906e9">
											<SHORT-NAME>NvMMainFunctionTriggering</SHORT-NAME>
											<DESC>
												<L-2 L="EN">The MainFunction can be scheduled in different ways, which allows adapting the runtime behavior
- FixedCycleTime: All activities are executed in the MainFunction with the defined cycle time.
- BackgroundTask: Activities that do not require a fixed cycle time run in the background task. The response time of such activities will depend on the current CPU load.
- FixedCycleAndBackground: Both options combined - currently not supported.
Note
If the system is overloaded, it may happen that the background task is no longer called.</L-2>
											</DESC>
											<LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
											<UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
											<IMPLEMENTATION-CONFIG-CLASSES>
												<ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
													<CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
													<CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
												</ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
											</IMPLEMENTATION-CONFIG-CLASSES>
											<ORIGIN>Vector Informatik</ORIGIN>
											<REQUIRES-INDEX>false</REQUIRES-INDEX>
											<SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
											<DEFAULT-VALUE>FixedCycleTime</DEFAULT-VALUE>
											<LITERALS>
												<ECUC-ENUMERATION-LITERAL-DEF UUID="fbba55f6-d8de-48be-8421-7429e04b1770">
													<SHORT-NAME>FixedCycleTime</SHORT-NAME>
													<LONG-NAME>
														<L-4 L="EN">FixedCycleTime	Task for Fixed Cycle Time	Vector Informatik</L-4>
													</LONG-NAME>
													<ORIGIN>Vector Informatik</ORIGIN>
												</ECUC-ENUMERATION-LITERAL-DEF>
												<ECUC-ENUMERATION-LITERAL-DEF UUID="7c6e7f82-ed5c-40c7-b36b-7f60ec814c83">
													<SHORT-NAME>BackgroundTask</SHORT-NAME>
													<LONG-NAME>
														<L-4 L="EN">Task for Background Handling</L-4>
													</LONG-NAME>
													<ORIGIN>Vector Informatik</ORIGIN>
												</ECUC-ENUMERATION-LITERAL-DEF>
												<ECUC-ENUMERATION-LITERAL-DEF UUID="8251986c-9d26-488c-9309-ba97ae64ce3e">
													<SHORT-NAME>FixedCycleAndBackground</SHORT-NAME>
													<LONG-NAME>
														<L-4 L="EN">Cycle time and background task combined option</L-4>
													</LONG-NAME>
													<ORIGIN>Vector Informatik</ORIGIN>
												</ECUC-ENUMERATION-LITERAL-DEF>
											</LITERALS>
										</ECUC-ENUMERATION-PARAM-DEF>
									</PARAMETERS>
									<REFERENCES>
										<ECUC-REFERENCE-DEF UUID="578e149e-a966-4d43-a84a-b94ef67af03c">
											<SHORT-NAME>NvMEcucPartitionRef</SHORT-NAME>
											<DESC>
												<L-2 L="EN">Maps the NvM to one or multiple ECUC partitions to make its C-APIs available in the partition and the corresponding OS applications.

If the NvM shall not be linked to any OS application, the parameter can be left empty.</L-2>
											</DESC>
											<ADMIN-DATA>
												<SDGS>
													<SDG GID="DV:CfgPostBuild">
														<SD GID="DV:variantMultiplicityPBL">false</SD>
													</SDG>
												</SDGS>
											</ADMIN-DATA>
											<LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
											<UPPER-MULTIPLICITY-INFINITE>true</UPPER-MULTIPLICITY-INFINITE>
											<IMPLEMENTATION-CONFIG-CLASSES>
												<ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
													<CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
													<CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
												</ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
											</IMPLEMENTATION-CONFIG-CLASSES>
											<ORIGIN>AUTOSAR_ECUC</ORIGIN>
											<REQUIRES-INDEX>false</REQUIRES-INDEX>
											<DESTINATION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR/EcucDefs/EcuC/EcucPartitionCollection/EcucPartition</DESTINATION-REF>
										</ECUC-REFERENCE-DEF>
										<ECUC-REFERENCE-DEF UUID="4d1ce594-4a4d-4aa2-854d-5edf23b120e7">
											<SHORT-NAME>NvMMasterEcucPartitionRef</SHORT-NAME>
											<DESC>
												<L-2 L="EN">Maps the NvM master to zero or one ECUC partition to assign the master functionality to a certain core. The ECUC partition referenced is a subset of the ECUC partitions where the NvM is mapped to.</L-2>
											</DESC>
											<ADMIN-DATA>
												<SDGS>
