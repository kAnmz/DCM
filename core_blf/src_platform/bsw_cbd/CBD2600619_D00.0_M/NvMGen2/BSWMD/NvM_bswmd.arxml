											<VALUE>false</VALUE>
										</ECUC-NUMERICAL-PARAM-VALUE>
										<ECUC-NUMERICAL-PARAM-VALUE>
											<DEFINITION-REF DEST="ECUC-BOOLEAN-PARAM-DEF">/MICROSAR/NvMGen2/NvM/NvMBlockDescriptor/NvMSelectBlockForWriteAll</DEFINITION-REF>
											<VALUE>true</VALUE>
