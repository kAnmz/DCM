																</ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
															</IMPLEMENTATION-CONFIG-CLASSES>
															<ORIGIN>Vector Informatik</ORIGIN>
															<REQUIRES-INDEX>false</REQUIRES-INDEX>
															<SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
															<MAX>4294967296</MAX>
															<MIN>1</MIN>
														</ECUC-INTEGER-PARAM-DEF>
														<ECUC-INTEGER-PARAM-DEF UUID="281f7e10-e15e-4d4b-bc50-02d518fab8e3">
															<SHORT-NAME>vMemStartAddress</SHORT-NAME>
															<DESC>
																<L-2 L="EN">Physical start address of this sector. 

In case of a sector batch this physical start address is the address of the first sector. The physical start address of the other sectors can be calculated by usage of parameter vMemSectorSize.</L-2>
															</DESC>
															<ADMIN-DATA>
																<SDGS>
																	<SDG GID="DV:Display">
																		<SD GID="DV:DefaultFormat">HEX</SD>
																	</SDG>
																</SDGS>
															</ADMIN-DATA>
