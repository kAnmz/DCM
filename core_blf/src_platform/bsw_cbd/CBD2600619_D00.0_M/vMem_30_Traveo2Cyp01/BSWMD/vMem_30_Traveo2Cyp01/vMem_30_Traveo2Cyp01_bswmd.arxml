													<POST-BUILD-CHANGEABLE>false</POST-BUILD-CHANGEABLE>
													<PARAMETERS>
														<ECUC-INTEGER-PARAM-DEF UUID="620f0e3b-51bf-4525-af08-5873e1b2eaea">
															<SHORT-NAME>vMemPeripheralStartAddress</SHORT-NAME>
															<DESC>
																<L-2 L="EN">The parameter defines the start address of the peripheral region. Needed to create the Os Peripheral Region container if the vMemUsePeripheralAccessApi is used.</L-2>
															</DESC>
															<ADMIN-DATA>
