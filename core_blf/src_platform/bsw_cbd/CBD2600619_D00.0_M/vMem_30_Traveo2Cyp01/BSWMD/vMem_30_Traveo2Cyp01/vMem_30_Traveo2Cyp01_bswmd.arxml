								<ECUC-PARAM-CONF-CONTAINER-DEF UUID="8884d411-d222-49ca-923f-d5b94183b70a">
									<SHORT-NAME>vMemGeneral</SHORT-NAME>
									<DESC>
										<L-2 L="EN">Container for general configuration parameters of the memory driver. These parameters are always pre-compile.</L-2>
									</DESC>
									<ADMIN-DATA>
										<SDGS>
											<SDG GID="DV:CfgPostBuild">
												<SD GID="DV:postBuildSelectableChangeable">false</SD>
