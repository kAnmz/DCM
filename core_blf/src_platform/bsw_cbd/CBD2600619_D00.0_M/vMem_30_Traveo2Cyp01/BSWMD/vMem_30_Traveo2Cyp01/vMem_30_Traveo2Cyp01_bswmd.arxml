																<DESTINATION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/MICROSAR/vMem_30_Traveo2Cyp01/vMem/vMemPublishedInformation/vMemFlash/vMemFlashRegion</DESTINATION-REF>
															</DESTINATION-REFS>
														</ECUC-CHOICE-REFERENCE-DEF>
													</REFERENCES>
													<SUB-CONTAINERS>
														<ECUC-PARAM-CONF-CONTAINER-DEF UUID="24b35a42-9d21-4887-bbb4-66f0f42e3610">
															<SHORT-NAME>vMemBurstSettings</SHORT-NAME>
															<DESC>
																<L-2 L="EN">Container for burst setting configuration parameters of the memory driver.

A sector burst can be used for improved performance.</L-2>
															</DESC>
															<ADMIN-DATA>
																<SDGS>
																	<SDG GID="DV:CfgPostBuild">
																		<SD GID="DV:postBuildSelectableChangeable">false</SD>
																		<SD GID="DV:postBuildNotDeletable">false</SD>
																	</SDG>
																</SDGS>
															</ADMIN-DATA>
															<LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
															<UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
															<POST-BUILD-CHANGEABLE>false</POST-BUILD-CHANGEABLE>
															<PARAMETERS>
																<ECUC-INTEGER-PARAM-DEF UUID="1e005ae3-c498-40c8-a07f-8ca94aba70ba">
																	<SHORT-NAME>vMemEraseBurstSize</SHORT-NAME>
																	<DESC>
																		<L-2 L="EN">Size of sector erase burst in bytes. A sector burst can be used for improved performance and is typically (a subset of) a sector batch.

Additionally the size also prescribes a necessary alignment: The phyiscal start address must be aligned to the size value, i.e. it must an integral multiple of the burst size.</L-2>
																	</DESC>
																	<ADMIN-DATA>
																		<SDGS>
																			<SDG GID="DV:Display">
																				<SD GID="DV:BaseUnit">BYTE</SD>
																				<SD GID="DV:Unit">KBYTE</SD>
																			</SDG>
																		</SDGS>
																	</ADMIN-DATA>
																	<LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
																	<UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
																	<IMPLEMENTATION-CONFIG-CLASSES>
																		<ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
																			<CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
																			<CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
																		</ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
																	</IMPLEMENTATION-CONFIG-CLASSES>
																	<ORIGIN>Vector Informatik</ORIGIN>
																	<REQUIRES-INDEX>false</REQUIRES-INDEX>
																	<SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
																	<DEFAULT-VALUE>65536</DEFAULT-VALUE>
																	<MAX>4294967296</MAX>
																	<MIN>1</MIN>
																</ECUC-INTEGER-PARAM-DEF>
																<ECUC-INTEGER-PARAM-DEF UUID="992bf0e7-fc3f-4c3f-b2c3-f54716a785c1">
																	<SHORT-NAME>vMemWriteBurstSize</SHORT-NAME>
																	<DESC>
																		<L-2 L="EN">Size of page write/program burst in bytes. A sector burst can be used for improved performance and is typically (a subset of) a sector batch.

Additionally the size also prescribes a necessary alignment: The phyiscal start address must be aligned to the size value, i.e. it must an integral multiple of the burst size.</L-2>
																	</DESC>
																	<ADMIN-DATA>
																		<SDGS>
																			<SDG GID="DV:Display">
																				<SD GID="DV:BaseUnit">BYTE</SD>
																			</SDG>
																		</SDGS>
																	</ADMIN-DATA>
																	<LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
																	<UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
																	<IMPLEMENTATION-CONFIG-CLASSES>
																		<ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
																			<CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
																			<CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
																		</ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
																	</IMPLEMENTATION-CONFIG-CLASSES>
																	<ORIGIN>Vector Informatik</ORIGIN>
																	<REQUIRES-INDEX>false</REQUIRES-INDEX>
																	<SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
																	<DEFAULT-VALUE>32</DEFAULT-VALUE>
																	<MAX>4294967296</MAX>
																	<MIN>1</MIN>
																</ECUC-INTEGER-PARAM-DEF>
																<ECUC-INTEGER-PARAM-DEF UUID="aa93337a-c8a9-4f0d-87e7-e68d21a932f5">
																	<SHORT-NAME>vMemPageBurstRamAlignment</SHORT-NAME>
																	<DESC>
																		<L-2 L="EN">In order to make use of page write bursts, a device might require a specific alignment of the data buffer (containing the data to be programmed to NV memory).

E.g. a device specific assembly buffer must be filled dword (32bit) wise. To avoid additionaly over head the buffer passed to write routine shall be correctly aligned according to this setting in order to use bursts.

Unless no alignment is necessary (value equals 1), the implementation shall check for expected alignment, and it shall reject a burst request if this check failed.</L-2>
																	</DESC>
																	<ADMIN-DATA>
																		<SDGS>
																			<SDG GID="DV:Display">
																				<SD GID="DV:DefaultFormat">DEC</SD>
																			</SDG>
																		</SDGS>
																	</ADMIN-DATA>
																	<LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
																	<UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
																	<IMPLEMENTATION-CONFIG-CLASSES>
																		<ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
																			<CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
																			<CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
																		</ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
																	</IMPLEMENTATION-CONFIG-CLASSES>
																	<ORIGIN>Vector Informatik</ORIGIN>
																	<REQUIRES-INDEX>false</REQUIRES-INDEX>
																	<SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
																	<DEFAULT-VALUE>1</DEFAULT-VALUE>
																	<MAX>256</MAX>
																	<MIN>1</MIN>
																</ECUC-INTEGER-PARAM-DEF>
															</PARAMETERS>
														</ECUC-PARAM-CONF-CONTAINER-DEF>
													</SUB-CONTAINERS>
												</ECUC-PARAM-CONF-CONTAINER-DEF>
											</SUB-CONTAINERS>
										</ECUC-PARAM-CONF-CONTAINER-DEF>
									</SUB-CONTAINERS>
								</ECUC-PARAM-CONF-CONTAINER-DEF>
