															<SHORT-NAME>vMemPageSize</SHORT-NAME>
															<DESC>
																<L-2 L="EN">Size of one page of this sector in bytes.

A page is the smallest writeable unit.</L-2>
															</DESC>
															<ADMIN-DATA>
																<SDGS>
																	<SDG GID="DV:Display">
																		<SD GID="DV:BaseUnit">BYTE</SD>
