						<ECUC-MODULE-DEF UUID="57587968-e525-4cdd-b33f-d4f4fadef419">
							<SHORT-NAME>vMem</SHORT-NAME>
							<DESC>
								<L-2 L="EN">Vector Memory driver for Traveo 2 devices. Provides services to access and operate non-volatile memory. Supports both data flash and code flash memory.

#Memory #NVMemory #DataStorage #OTA #SoftwareDownload #HSM #FBL
#Vector</L-2>
							</DESC>
